namespace NUBE.Interop;

union EditorMessage {
	InitializationDetails
}

union EngineMessage {
	EngineStartupCommand,
	EngineShutdownCommand,
	KeyboardEvent
}

table EditorEnvelope {
	payload:EditorMessage;
}

table EngineEnvelope {
	payload:EngineMessage;
}

table InitializationDetails {
	max_frames_in_flight:short;
	target_handles:[uint64];
	engine_url:string;
}

table KeyboardEvent {
	scancode:ushort;
	is_down:bool;
}

table EngineStartupCommand {
	unused:bool = true;
}
table EngineShutdownCommand {
	unused:bool = true;
}

root_type EditorEnvelope;
root_type EngineEnvelope;
