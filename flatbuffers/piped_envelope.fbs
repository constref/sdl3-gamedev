namespace NUBE.Interop.Piped;

union PipedMessage {
    KeyboardEvent,
    MouseMoveEvent
}

table PipedEnvelope {
    payload: PipedMessage;
}

table KeyboardEvent {
	scancode:ushort;
	is_down:bool;
}

table MouseMoveEvent {
    x:int;
    y:int;
    x_rel:int;
    y_rel:int;
}

root_type PipedEnvelope;
